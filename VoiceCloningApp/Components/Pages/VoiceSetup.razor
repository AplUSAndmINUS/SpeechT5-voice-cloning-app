@page "/voice-setup"
@inject TtsApiService ApiService
@inject EmbeddingStorageService EmbeddingStorage

<div class="page-container">
    <h1>🎤 Voice Setup</h1>
    <p class="page-description">
        Upload a WAV recording of your voice (ideally one minute, clear speech) to
        generate a reusable voice profile. You only need to do this once.
    </p>

    @if (EmbeddingStorage.HasEmbedding)
    {
        <div class="alert alert-success">
            ✅ A voice profile is already saved. You can generate audio now, or
            re-upload below to replace it.
        </div>
    }

    <div class="upload-section">
        <h2>Upload Voice Sample</h2>

        <div class="file-upload-area @(_isDragOver ? "drag-over" : "")"
             @ondragover:preventDefault
             @ondragover="HandleDragOver"
             @ondragleave="HandleDragLeave"
             @ondrop:preventDefault
             @ondrop="HandleDrop">
            <InputFile OnChange="HandleFileSelected"
                       accept=".wav"
                       class="file-input"
                       id="wav-upload" />
            <label for="wav-upload" class="file-upload-label">
                @if (_selectedFileName is not null)
                {
                    <span class="file-chosen">📄 @_selectedFileName</span>
                }
                else
                {
                    <span>
                        <span class="upload-icon">📁</span><br />
                        Click to choose a WAV file, or drag and drop here.
                    </span>
                }
            </label>
        </div>

        @if (_validationError is not null)
        {
            <div class="alert alert-error">⚠️ @_validationError</div>
        }

        <button class="btn btn-primary btn-large"
                @onclick="GenerateVoiceProfile"
                disabled="@(_selectedFile is null || _isLoading)">
            @if (_isLoading)
            {
                <span class="spinner"></span>
                <span>Generating voice profile…</span>
            }
            else
            {
                <span>🚀 Generate Voice Profile</span>
            }
        </button>
    </div>

    @if (_statusMessage is not null)
    {
        <div class="alert @(_isError ? "alert-error" : "alert-success")">
            @_statusMessage
        </div>
    }
</div>

@code {
    private IBrowserFile? _selectedFile;
    private string? _selectedFileName;
    private string? _validationError;
    private string? _statusMessage;
    private bool _isLoading;
    private bool _isError;
    private bool _isDragOver;

    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _validationError = null;
        _statusMessage = null;
        var file = e.File;

        if (!file.Name.EndsWith(".wav", StringComparison.OrdinalIgnoreCase))
        {
            _validationError = "Unsupported audio format. Please upload a WAV file (.wav).";
            _selectedFile = null;
            _selectedFileName = null;
            return;
        }

        _selectedFile = file;
        _selectedFileName = file.Name;
    }

    private void HandleDragOver() => _isDragOver = true;
    private void HandleDragLeave() => _isDragOver = false;

    private async Task HandleDrop(DragEventArgs e)
    {
        _isDragOver = false;
        // Drag-and-drop for files inside BlazorWebView is handled via InputFile;
        // the visual feedback is provided here.
        await Task.CompletedTask;
    }

    private async Task GenerateVoiceProfile()
    {
        if (_selectedFile is null) return;

        _isLoading = true;
        _statusMessage = null;
        _isError = false;

        try
        {
            // Stream the file to the API (max 50 MB)
            const long maxBytes = 50 * 1024 * 1024;
            await using var stream = _selectedFile.OpenReadStream(maxBytes);
            var embedding = await ApiService.GetEmbeddingAsync(stream, _selectedFile.Name);

            if (embedding is null || embedding.Length != 512)
            {
                _isError = true;
                _statusMessage = "The backend returned an unexpected response. Please try again.";
                return;
            }

            await EmbeddingStorage.SaveAsync(embedding);
            _statusMessage = "✅ Voice profile saved! You can now generate audio.";
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("503"))
        {
            _isError = true;
            _statusMessage = "Backend not running. Please start the Python service (uvicorn app:app --port 8000) and try again.";
        }
        catch (HttpRequestException)
        {
            _isError = true;
            _statusMessage = "Could not reach the backend. Make sure the Python service is running on http://localhost:8000.";
        }
        catch (Exception ex)
        {
            _isError = true;
            _statusMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
